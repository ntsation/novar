---
// The development version says so on every page, like the "dev" manual of other languages.
import Default from '@astrojs/starlight/components/Banner.astro';
---

{
  process.env.SITE_VERSION === 'dev' ? (
    <div class="dev-banner" data-pagefind-ignore>
      This is the documentation of the development version (the <code>main</code> branch). It can describe things
      that are not released yet.
    </div>
  ) : (
    <Default {...Astro.props} />
  )
}

<style>
  .dev-banner {
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    background: var(--sl-color-orange-low);
    color: var(--sl-color-orange-high);
    text-align: center;
    font-size: var(--sl-text-sm);
  }
</style>
